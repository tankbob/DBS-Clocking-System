FROM php:8.2-cli

RUN apt-get update \
    && apt-get install -y \
        git \
        unzip \
        libzip-dev \
        zlib1g-dev \
        libpng-dev \
        libjpeg62-turbo-dev \
        libfreetype6-dev \
        vim \
    && docker-php-ext-configure gd \
        --with-freetype \
        --with-jpeg \
    && docker-php-ext-install -j$(nproc) gd mysqli pdo_mysql zip \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2.2.30 \
    /usr/bin/composer \
    /usr/local/bin/composer

RUN echo set mouse=>~/.vimrc

WORKDIR /appENTRYPOINT ["/bin/bash"]
